# Required. Keep this file private and never commit your real key.
OPENROUTER_API_KEY=

# Optional OpenRouter attribution.
OPENROUTER_APP_NAME=G Force Voice Agent
# OPENROUTER_HTTP_REFERER=https://your-app.example

# Browser application.
PIPELINE_APP_PORT=7860
PIPELINE_TLS=true

# Pi chief-of-staff backend. The default Pi tools are read-only.
CHIEF_PI_PROVIDER=openai-codex
CHIEF_PI_MODEL=gpt-5.6-sol
CHIEF_PI_THINKING_LEVEL=low
# Host Pi OAuth file populated by `/login` with ChatGPT Plus/Pro (Codex).
PI_AUTH_FILE=/root/.pi/agent/auth.json
CHIEF_PI_TOOLS=read,grep,find,ls
CHIEF_PI_MAX_WORKERS=2
PI_AGENT_TIMEOUT_SECONDS=300
PI_AGENT_DATA_VOLUME=g-force-voice-agent_pi_agent_data

# Local speech runs on GPU 0 by default.
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE_TYPE=float16
FASTER_WHISPER_NO_SPEECH_PROB=0.4
FASTER_WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
HF_DOWNLOAD_WORKERS=1
HF_HUB_DISABLE_XET=true
# HF_TOKEN=  # Optional; raises Hugging Face download rate limits.
ONNX_PROVIDER=CUDAExecutionProvider

# Persistent Docker volumes. Change these names for independent state.
MODEL_CACHE_VOLUME=g-force-voice-agent_model_cache

# Optional runtime tuning.
CHAT_HISTORY_RECENT_TURNS=20
# AGENT_FILLER_THRESHOLD_SECONDS=0.3
# PI_AGENT_URL=http://pi-agent:8787
# PIPELINE_IDLE_TIMEOUT_SECS=600
# AUDIO_OUT_10MS_CHUNKS=10
# ENABLE_ASR_AUDIO_DUMP=false
# ENABLE_TTS_AUDIO_DUMP=false

# Optional tracing.
# ENABLE_TRACING=false
# OTEL_CONSOLE_EXPORT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example:4317
